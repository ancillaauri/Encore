{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Encore",
  "version": "0.2.1",
  "identifier": "com.encore.recorder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Encore",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Encore",
    "copyright": "Encore contributors",
    "shortDescription": "Lightweight game recorder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/encore-engine"
    ],
    "resources": {
      "resources/ffmpeg.exe": "ffmpeg.exe",
      "resources/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERTM5MkJDMzJCMUQ1Q0MKUldUTTFiRXl2SkxqL1ZwRUNNSzB5c2g2Y1lKd1dYa0wxRUVjalEvb1pWQ0VNYk1kUlFHbzhYa08K",
      "endpoints": [
        "https://github.com/ancillaauri/Encore/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
